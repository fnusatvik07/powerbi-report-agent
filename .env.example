# Copy this file to .env and fill in your values. .env is gitignored and never committed.

# ---- Model backend for the natural-language `chat` agent ----
# The deep agent runs on a LangChain model. For Anthropic (default), set your key here.
ANTHROPIC_API_KEY=

# LangChain model id the agent runs on. Examples:
#   claude-sonnet-4-5-20250929   (Anthropic, default)
#   gpt-4o                       (needs OPENAI_API_KEY + langchain-openai)
PBI_AGENT_MODEL=claude-sonnet-4-5-20250929

# If you use an OpenAI model instead, set this and install langchain-openai.
# OPENAI_API_KEY=

# ---- Power BI / Fabric publishing target ----
# Fabric workspace path segment to publish into.
#   "My workspace.Personal"   -> your personal workspace
#   "Team Name.Workspace"     -> a shared Fabric workspace
PBI_TARGET_WORKSPACE=My workspace.Personal

# Where generated PBIP projects are written.
PBI_OUTPUT_DIR=./build

# NOTE: publishing authenticates interactively via the Fabric CLI, not with a secret here.
# Run once:  fab auth login
