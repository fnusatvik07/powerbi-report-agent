        <mxCell id="service" value="Power BI Service&#10;Semantic Model + Report&#10;(interactive fab auth login)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="400" width="220" height="90" as="geometry" />
