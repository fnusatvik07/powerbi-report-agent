          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="user" value="User&#10;natural-language request&#10;&quot;Build a cricket dashboard and publish it&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
