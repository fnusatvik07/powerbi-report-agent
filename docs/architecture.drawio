          <mxGeometry x="330" y="70" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="model" value="Model backend&#10;Anthropic / OpenAI via .env" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
