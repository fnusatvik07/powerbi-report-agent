        <mxCell id="e1" style="endArrow=classic;html=1;strokeColor=#333333;" edge="1" parent="1" source="user" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#D6B656;" edge="1" parent="1" source="agent" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
