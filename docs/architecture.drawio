        <mxCell id="files" value="PBIP project on disk&#10;.Report (PBIR JSON)&#10;.SemanticModel (TMDL + inline data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
